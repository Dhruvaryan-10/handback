{
  "name": "handback",
  "version": "0.1.0",
  "description": "AI photo check-out and check-in for rental deposits, held and settled with PayPal.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "demo": "concurrently -n demo,web -c magenta,green \"tsx server/src/demo.ts\" \"npm:dev:client\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spike:paypal": "tsx scripts/paypal-spike.ts",
    "check:gemini": "tsx scripts/gemini-check.ts",
    "db:schema": "tsx scripts/apply-schema.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "motion": "^12.43.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
