# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=8787
# Public URL of the app (used for PayPal return/cancel URLs). Local: http://localhost:5173
APP_URL=http://localhost:5173
# Shared secret the shop console sends to approve settlements (header x-shop-token).
SHOP_ADMIN_TOKEN=change-me-to-a-long-random-string

# --- PayPal (sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your app
# Use a US sandbox business account for the app; a US sandbox personal account to pay.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# After you register a webhook pointing at {APP_URL}/api/paypal/webhook, paste its ID here.
PAYPAL_WEBHOOK_ID=

# --- AI (Google Gemini) ---
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Findings below this confidence go to manual review instead of being priced.
AI_CONFIDENCE_THRESHOLD=0.6

# --- Database ---
# Leave empty to use the in-memory store (data resets on restart).
# Neon free Postgres: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
